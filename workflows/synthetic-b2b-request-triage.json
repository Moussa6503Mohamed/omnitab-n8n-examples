{
  "name": "OmniTab | Synthetic B2B Request Triage Demo",
  "nodes": [
    {
      "id": "2a243c2c-2a1f-4057-8ff5-9d2a0e367545",
      "name": "Run Safe Sample",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        160,
        320
      ],
      "parameters": {}
    },
    {
      "id": "25fa9d01-a8a8-477f-b119-c94716ac86b9",
      "name": "Generate Synthetic Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [\n  {json:{requestId:\"DEMO-001\",name:\"Synthetic Buyer\",email:\"buyer@example.com\",service:\"workflow automation\",contactPermission:true,requirements:\"Connect an approval queue\"}},\n  {json:{requestId:\"DEMO-002\",name:\"Synthetic Reviewer\",email:\"\",service:\"AI assistant\",contactPermission:true,requirements:\"Needs qualification review\"}},\n  {json:{requestId:\"DEMO-003\",name:\"Synthetic Opt-Out\",email:\"no-contact@example.com\",service:\"customer support\",contactPermission:false,requirements:\"Do not contact\"}},\n  {json:{requestId:\"DEMO-004\",name:\"Synthetic Unclear\",email:\"unknown@example.com\",service:\"\",contactPermission:true,requirements:\"Needs classification\"}}\n];"
      }
    },
    {
      "id": "1e0d8dee-0fa4-4778-9100-f32eccc91ac8",
      "name": "Validate and Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(item => {\n  const j=item.json;\n  const permitted=j.contactPermission===true;\n  const validEmail=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(j.email||\"\"));\n  const hasService=String(j.service||\"\").trim().length>0;\n  const route=!permitted?\"do_not_contact\":(!validEmail||!hasService?\"manual_review\":\"qualified\");\n  const reason=!permitted?\"No permission to contact\":(!validEmail?\"Contact email missing or invalid\":(!hasService?\"Requested service unspecified\":\"Basic checks passed; human qualification required\"));\n  return {json:{...j,route,reason,synthetic:true}};\n});"
      }
    },
    {
      "id": "b292eb44-b362-4fee-81b9-2f1e27587c16",
      "name": "Route Requests with Fallback",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        900,
        320
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "qualified",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "qualified"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "manual_review",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "manual_review"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "do_not_contact",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "do_not_contact"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Investigate"
        }
      }
    },
    {
      "id": "0d13359f-1483-404f-a39c-243ea84be4e4",
